# Sao chép file này thành backend/.env. Không commit file có secret.
# DEMO chạy đầy đủ khi không có backend/.env.
PORT=3210
DATA_PATH=data/tarot.sqlite

# TikFinity Desktop phải chạy trên cùng máy với backend.
# URL cũng đổi được trong admin; biến môi trường này ưu tiên hơn URL đã lưu.
TIKFINITY_URL=ws://localhost:21213/
TIKFINITY_AUTOCONNECT=true

# AI tùy chọn: endpoint tương thích Chat Completions.
# Không điền key vào trình duyệt. Không có model mặc định.
# AI_BASE_URL=https://your-provider.example/v1
# AI_API_KEY=your-key-here
# AI_MODEL=provider-supported-model-name
# AI_JSON_MODE=true

# Gemini: dùng endpoint tương thích OpenAI, key vẫn chỉ lưu tại backend/.env.
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_API_KEY=your-gemini-key-here
# AI_MODEL=gemini-3.5-flash-lite
# Model này đã thử thành công trong lần cập nhật; có thể đổi theo model tài khoản hỗ trợ.

# TTS tùy chọn: endpoint do bạn cấu hình, nhận JSON và trả FILE audio trực tiếp.
# Đây không phải adapter tự động cho mọi hãng TTS. Xem README về hợp đồng HTTP.
# TTS_URL=http://127.0.0.1:5005/tts
# TTS_API_KEY=optional-bearer-token

